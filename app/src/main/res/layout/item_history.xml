<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <TextView
        android:id="@+id/history_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/voicekb_history_text_primary"
        android:textSize="15sp"
        tools:text="Write a reply to the email and add that we are moving the meeting to Thursday afternoon." />

    <TextView
        android:id="@+id/history_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/voicekb_history_text_secondary"
        android:textSize="12sp"
        tools:text="14:32 · 0:12 · Groq · whisper-large-v3-turbo" />

    <TextView
        android:id="@+id/history_details_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="2dp"
        android:text="@string/voicekb_history_details_show"
        android:textColor="@color/voicekb_history_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/history_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/voicekb_history_text_muted"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="{ &quot;error&quot;: { &quot;message&quot;: &quot;...&quot; } }" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/history_play_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_history_play"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/history_play_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/voicekb_history_play"
                android:src="@drawable/ic_lucide_play_24"
                app:tint="@color/voicekb_history_accent_strong" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/history_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progressBackgroundTint="@color/voicekb_history_slider_track"
            android:progressTint="@color/voicekb_blue"
            android:thumbTint="@color/voicekb_blue" />

        <TextView
            android:id="@+id/history_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/voicekb_history_text_secondary"
            android:textSize="12sp"
            tools:text="0:03 / 0:12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/history_action_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/voicekb_history_action_copy"
                android:src="@drawable/ic_baseline_content_copy_24"
                app:tint="@color/voicekb_history_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/voicekb_history_action_copy"
                android:textColor="@color/voicekb_history_text_secondary"
                android:textSize="13sp"
                android:textStyle="normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_action_reprocess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/voicekb_history_action_reprocess"
                android:src="@drawable/ic_lucide_refresh_24"
                app:tint="@color/voicekb_history_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/voicekb_history_action_reprocess"
                android:textColor="@color/voicekb_history_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_action_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/voicekb_history_action_delete"
                android:src="@drawable/ic_baseline_delete_24"
                app:tint="@color/voicekb_history_danger" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/voicekb_history_action_delete"
                android:textColor="@color/voicekb_history_danger"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/voicekb_history_divider" />
</LinearLayout>
